NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Post-deployment — fill in after running contracts/script/Deploy.s.sol
NEXT_PUBLIC_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SAMPLE_NFT_ADDRESS=0x0000000000000000000000000000000000000000

# RPC — public fallback is used when these are unset
# NEXT_PUBLIC_RPC_URL is exposed to the browser; point at /api/rpc if the
# upstream RPC is not browser-accessible (e.g. internal/firewalled endpoint).
NEXT_PUBLIC_RPC_URL=https://rpc.ritualfoundation.org
NEXT_PUBLIC_RPC_WS_URL=wss://rpc.ritualfoundation.org/ws
# RITUAL_RPC_URL is server-only (used by the /api/rpc proxy)
RITUAL_RPC_URL=https://rpc.ritualfoundation.org
