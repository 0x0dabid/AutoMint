# Deployer wallet private key (no 0x prefix)
PRIVATE_KEY=your_private_key_here

# Ritual Chain RPC (default: public)
RITUAL_RPC_URL=https://rpc.ritualfoundation.org

# Explorer API key for contract verification
ETHERSCAN_API_KEY=your_key_here

# Post-deployment — fill these in after running Deploy.s.sol
FACTORY_ADDRESS=0x0
SAMPLE_NFT_ADDRESS=0x0
